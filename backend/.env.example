# ============================================================================
# AI问数 · 后端环境变量模板
# 用法：cp backend/.env.example backend/.env，然后在 .env 里填写真实值
# 注意：.env 已在 .gitignore 中，绝不要提交
# ============================================================================

# ---------- 模型（deepseek-flash，OpenAI 兼容协议） ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 你的 Key 填在这里，形如 sk-xxxxxxxx
LLM_API_KEY=
# 是否开启思考模式；关闭可显著降低首 token 延迟
LLM_THINKING=true
# 思考强度：low / medium / high
LLM_REASONING_EFFORT=high
# 单次请求超时（秒），thinking 模式建议不低于 60
LLM_TIMEOUT=90

# ---------- 数据库 ----------
# 业务库（只读），相对路径以 backend/ 为基准
DB_PATH=data/warehouse.db
# 元数据库（会话 / 配置 / 反馈，可写）
APP_DB_PATH=data/app.db

# ---------- SQL 执行保护 ----------
# 单次查询最多返回行数
SQL_MAX_ROWS=200
# 单条 SQL 执行超时（毫秒）
SQL_TIMEOUT_MS=5000

# ---------- 应用 ----------
LOG_LEVEL=INFO
